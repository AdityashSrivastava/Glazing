# Supabase Project URL
SUPABASE_URL=

# Supabase Service Role Key (Used server-side for authoritative database operations)
SUPABASE_KEY=

# Supabase JWT Secret (From Supabase Dashboard -> Project Settings -> API / JWT Settings)
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed origins for CORS (e.g. http://localhost:5173,https://glazing.vercel.app)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://glazing-lac.vercel.app

# Secret token required for automated cron maintenance endpoints (e.g. nightly snapshot generation)
CRON_SECRET=replace_with_secure_random_32_char_token

# Temporary initial password for CLI bootstrap provisioning script (create_users.py)
BOOTSTRAP_OPERATIVE_PASSWORD=

